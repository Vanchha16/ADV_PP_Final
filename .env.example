# Copy to .env and fill in. Never commit the real .env.

SHOP_NAME=Anime World Shop
SECRET_KEY=change-me-to-a-long-random-string

# Admin login (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Database. Leave empty to use SQLite in instance/shop.db.
# Example for Postgres: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# ---- Bakong KHQR ----
# Your Bakong account ID that receives the money (e.g. yourname@aclb).
BAKONG_ACCOUNT_ID=yourname@aclb
BAKONG_MERCHANT_NAME=Anime World Shop
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_PHONE=
KHQR_CURRENCY=USD
# Developer token from https://api-bakong.nbc.gov.kh/register
# Leave empty to run in DEMO mode (adds a "simulate payment" button).
BAKONG_TOKEN=
# Bakong only accepts calls from Cambodian IPs. If your server is abroad,
# point this at a Cambodia proxy and set its shared key.
BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1
BAKONG_PROXY_KEY=
# Force demo mode on/off (default: on when BAKONG_TOKEN is empty)
PAYMENT_DEMO_MODE=
QR_TTL_MINUTES=10
